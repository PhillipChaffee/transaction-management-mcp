{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic Transaction Management Fixture",
    "version": "0.0.0",
    "description": "Representative anomaly classes for generator tests. Not a vendor document."
  },
  "paths": {
    "/v1/items/{itemId}": {
      "get": {
        "operationId": "Items_GetItem",
        "tags": ["Sales"],
        "summary": "Path + query read",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "includeDetails",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" }
          }
        ],
        "responses": {
          "200": {
            "description": "Item",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id", "name"],
                  "properties": {
                    "id": { "type": "string" },
                    "name": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "Items_CreateItem",
        "tags": ["Sales"],
        "summary": "Path + body write",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["id"],
                  "properties": {
                    "id": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/items/{itemId}/open-body": {
      "put": {
        "operationId": "Items_OpenBodyUpdate",
        "tags": ["Sales"],
        "summary": "Empty body schema write",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/items/{itemId}/status": {
      "post": {
        "operationId": "Items_QueryWriteStatus",
        "tags": ["Sales"],
        "summary": "Query write with no body",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "name": "status",
            "in": "query",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Status changed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/items/{itemId}/close": {
      "post": {
        "operationId": "Items_NoBodyClose",
        "tags": ["Sales"],
        "summary": "No-body write",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": {
            "description": "No content"
          }
        }
      }
    },
    "/v1/documents/{documentId}": {
      "post": {
        "operationId": "Documents_AddDocument",
        "tags": ["Listing Documents"],
        "summary": "Base64 upload",
        "parameters": [
          {
            "name": "documentId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["fileName", "base64Content"],
                "properties": {
                  "fileName": { "type": "string" },
                  "base64Content": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "documentId": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/cda/{saleGuid}": {
      "put": {
        "operationId": "CdaDocumentData_Update",
        "tags": ["Sale CDA document data"],
        "summary": "Typeless nullable document payload",
        "parameters": [
          {
            "name": "saleGuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["documentData"],
                "properties": {
                  "documentData": {
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "saved": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/linked/{itemId}": {
      "get": {
        "operationId": "Items_GetLinkedEmptyValue",
        "tags": ["Sales"],
        "summary": "Linked response with empty value wrapper",
        "parameters": [
          {
            "name": "itemId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Linked wrapper",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "object"
                    },
                    "warnings": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "links": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "href": { "type": "string" },
                          "rel": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/bulk/export": {
      "get": {
        "operationId": "BulkExport_GetExport",
        "tags": ["Bulk Export"],
        "summary": "Bulk array export",
        "parameters": [
          {
            "name": "modifiedSince",
            "in": "query",
            "required": false,
            "schema": { "type": "string", "format": "date-time" }
          }
        ],
        "responses": {
          "200": {
            "description": "Bulk rows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "replicaTimestamp": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/files/{fileId}/content": {
      "get": {
        "operationId": "Files_GetOctetStream",
        "tags": ["Listing Documents"],
        "summary": "Octet-stream response",
        "parameters": [
          {
            "name": "fileId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Binary",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sales": {
      "get": {
        "operationId": "Sales_GetSales",
        "tags": ["Sales"],
        "summary": "Impersonation query parameter",
        "parameters": [
          {
            "name": "userBeingImpersonated",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "Sales page",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "guid": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v2/sales/{saleGuid}": {
      "get": {
        "operationId": "V2Sales_GetSale",
        "tags": ["V2 Sales"],
        "summary": "v2 twin read",
        "parameters": [
          {
            "name": "saleGuid",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "responses": {
          "200": {
            "description": "Sale",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "guid": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
