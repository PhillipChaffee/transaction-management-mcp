# Copy to .env for local runs. Never commit real values.
# Normal SkySlope account keys alone are insufficient; CLIENT_ID/SECRET need API onboarding.

SKYSLOPE_TM_CLIENT_ID=your-client-id
SKYSLOPE_TM_CLIENT_SECRET=your-client-secret
SKYSLOPE_TM_ACCESS_KEY=your-access-key
SKYSLOPE_TM_ACCESS_SECRET=your-access-secret

# Optional runtime selection (non-secret)
# SKYSLOPE_TM_TOOLSETS=default
# SKYSLOPE_TM_TOOLS=
# SKYSLOPE_TM_EXCLUDE_TOOLSETS=
# SKYSLOPE_TM_EXCLUDE_TOOLS=
# SKYSLOPE_TM_READ_WRITE=false
# SKYSLOPE_TM_ALLOW=
# SKYSLOPE_TM_MAX_OUTPUT_BYTES=1048576
# SKYSLOPE_TM_MAX_BINARY_BYTES=10485760
# SKYSLOPE_TM_MAX_UPLOAD_BYTES=26214400
# SKYSLOPE_TM_MAX_BULK_ITEMS=100

# Stdio (default) or http for the HTTP binary
# SKYSLOPE_TM_TRANSPORT=stdio

# HTTP transport only (MCP bearer is separate from SkySlope credentials)
# SKYSLOPE_TM_HTTP_HOST=127.0.0.1
# SKYSLOPE_TM_HTTP_PORT=3000
# SKYSLOPE_TM_HTTP_BEARER_TOKEN=your-mcp-bearer-token
# SKYSLOPE_TM_HTTP_ALLOW_REMOTE=false
# SKYSLOPE_TM_HTTP_ALLOWED_HOSTS=
# SKYSLOPE_TM_HTTP_ALLOWED_ORIGINS=
